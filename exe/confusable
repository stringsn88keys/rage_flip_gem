#!/usr/bin/env ruby

require_relative "../lib/rage_flip"

text = ARGV.join(" ")

if text.empty?
  puts "Usage: confusable <text_to_confuse>"
  exit 1
end

result = RageFlip::Confusable.process(text)

if RageFlip::Clipboard.copy(result)
else
  puts "Failed to copy to clipboard, but here's your confusable text:"
end
puts result
